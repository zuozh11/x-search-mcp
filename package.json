{
  "name": "@zz1996/x-search-mcp",
  "version": "0.2.5",
  "description": "X search evidence for joint search with the host official Web Search",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuozh11/x-search-mcp.git"
  },
  "homepage": "https://github.com/zuozh11/x-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/zuozh11/x-search-mcp/issues"
  },
  "bin": {
    "x-search-mcp": "bin/x-search-mcp"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "xai",
    "x-search",
    "x"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
